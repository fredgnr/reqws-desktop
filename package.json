{
  "name": "reqws-desktop",
  "productName": "ReqWS",
  "version": "0.1.0",
  "description": "A local macOS feature workspace manager for physically isolated multi-repository Git work.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:renderer": "vitest run tests/renderer",
    "i18n:scan": "node scripts/check-i18n.mjs --scan",
    "i18n:apply": "node scripts/check-i18n.mjs --apply",
    "i18n:check": "node scripts/check-i18n.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && npm run docs:check && npm test",
    "package:macos": "node scripts/run-install-macos.mjs --package-only",
    "install:macos": "node scripts/run-install-macos.mjs"
  },
  "keywords": [
    "electron",
    "git",
    "multi-repo",
    "workspace"
  ],
  "author": "ReqWS contributors",
  "license": "MIT",
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "dependencies": {
    "i18next": "26.2.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
