+"""Disposable S0 host runner; reuses the owned-profile boundaries, not the V10 report."""
+import argparse
+import json
+import os
+import re
+from statistics import median
+from check_compose_artifact import check_compose_artifact
+from pathlib import Path
+import sys
+import tempfile
+import xml.etree.ElementTree as ET
+from run_local_ide import (ROOT, EnvironmentBlocked, local_only, optional_license_server,
+    initialize_profile, checked_path, lock_profile, isolate_project_state,
+    validate_plugin, read_policy, write_json, execute, session_closed, digest)
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--profile', type=Path, required=True)
+parser.add_argument('--archive', type=Path, required=True)
+parser.add_argument('--version', required=True)
+parser.add_argument('--scenario', choices=['input', 'performance'], default='input')
+parser.add_argument('--variant', choices=['compose', 'swing'], default='compose')
+parser.add_argument('--foreground-handshake', action='store_true')
+args = parser.parse_args()
+if args.scenario == 'input' and args.variant != 'compose':
+    parser.error('Input scenario requires the Compose candidate')
+run = Path(tempfile.mkdtemp(prefix='reqws-compose-host-')).resolve()
+run.chmod(0o700)
+(run/'run-root.txt').write_text(str(run)+'\n')
+report = {'scope':'compose-s0', 'status':'not-run', 'scenario':args.scenario, 'variant':args.variant, 'captureProtocol':'actual-screen-v2'}
+try:
+    local_only()
+    server = optional_license_server()
+    policy = read_policy()
+    profile, metadata = initialize_profile(args.profile, policy)
+    with lock_profile(profile):
+        active = checked_path(profile/'active-session.json')
+        if active.exists():
+            raise EnvironmentBlocked('PREVIOUS_SESSION_UNCONFIRMED', 'Dedicated session remains unconfirmed')
+        archive = checked_path(args.archive)
+        candidate = validate_plugin(archive,args.version)
+        if args.variant == 'compose':
+            check_compose_artifact(archive, args.version)
+        report['candidate'] = {'path':str(archive),'sha256':candidate['sha256'],'version':args.version}
+        if not server and not (profile/'preparation-session.json').is_file():
+            raise EnvironmentBlocked('AUTHORIZATION_PREPARATION_REQUIRED','Dedicated authorization preparation required')
+        isolate_project_state(profile,run)
+        write_json(active,{'runRoot':str(run),'mode':'compose-s0'})
+        command = [str(ROOT/'integrations/goland/gradlew'),'-p',str(ROOT/'integrations/goland'),
+          'composeHostTest','--no-daemon','--no-configuration-cache','--console=plain',
+          '-Porg.jetbrains.intellij.platform.useCacheRedirector=false',
+          f'-PreqwsS0ForegroundHandshake={str(args.foreground_handshake).lower()}',
+          f'-PreqwsS0Scenario={args.scenario}', f'-PreqwsS0Variant={args.variant}',
+          f'-PreqwsLocalIdeProfile={profile}',f'-PreqwsLocalIdeRunRoot={run}',
+          f'-PreqwsPluginArchive={archive}',f'-PreleaseVersion={args.version}',
+          f"-PreqwsPluginSha256={candidate['sha256']}"]
+        print(f'S0 report: {run}/report.json',flush=True)
+        try:
+            code = execute(command,run/'host.log',1800,{**os.environ,
+              'REQWS_LOCAL_IDE_RUN_ROOT':str(run),'REQWS_LOCAL_IDE_PROFILE':str(profile)})
+        finally:
+            if session_closed(run,'run'):
+                active.unlink()
+        report['exitCode'] = code
+        if digest(archive) != candidate['sha256']:
+            raise ValueError('Candidate changed')
+        if (run/'environment-blocked.json').exists():
+            detail=json.loads((run/'environment-blocked.json').read_text())
+            raise EnvironmentBlocked(detail['code'],detail['message'])
+        if code != 0:
+            raise ValueError('Host failed; inspect host.log')
+        cases = [c for p in (run/'junit').glob('TEST-*.xml') for c in ET.parse(p).getroot().iter('testcase')]
+        expected_test = 'realComposeInputAndContentRecreation()' if args.scenario == 'input' else 'performanceBaseline()'
+        if len(cases)!=1 or cases[0].get('name')!=expected_test or any(c.find(t) is not None for c in cases for t in ['failure','error','skipped']):
+            raise ValueError('Required non-skipped S0 scenario did not pass')
+        events = [line.split('\t') for line in (run/'processes.tsv').read_text().splitlines()]
+        expected_processes = 1 if args.scenario == 'input' else 3
+        pids = list(dict.fromkeys(pid for pid, phase in events))
+        if len(pids) != expected_processes or any([phase for seen, phase in events if seen == pid] != ['started', 'passed', 'exited'] for pid in pids):
+            raise ValueError('Process cleanup did not pass')
+        lifecycle = []
+        for log in (run/'out/ide-tests/tests').rglob('idea.log'):
+            values = {}
+            for resource in ['listener'] + (['composition'] if args.variant == 'compose' else []):
+                counts = [int(v) for v in re.findall(rf'S0 {resource} active=(\d+)', log.read_text())]
+                if not counts or counts[-1] != 0 or min(counts) != 0 or max(counts) != 1 or counts.count(1) != counts.count(0) or counts.count(1) < 21:
+                    raise ValueError(f'{resource} lifecycle did not balance: {counts}')
+                if resource == 'listener' and counts.count(1) != 21:
+                    raise ValueError('Hide/show duplicated the listener')
+                values[resource] = {'created': counts.count(1), 'disposed': counts.count(0), 'maxActive': max(counts)}
+            lifecycle.append(values)
+        if len(lifecycle) != expected_processes:
+            raise ValueError('Missing IDE lifecycle log')
+        if args.scenario == 'performance':
+            rows = (run/'metrics.tsv').read_text().splitlines()
+            opens = (run/'first-open.tsv').read_text().splitlines()
+            if len(rows) != 201 or len(opens) != 3:
+                raise ValueError('Incomplete performance samples')
+            performance = []
+            for round_id in range(3):
+                samples = [line.split('\t') for line in rows if line.startswith(f'{round_id}\t')]
+                expected = {f'{phase}-{i}' for phase, count in [('before', 13), ('after', 13), ('hide-show', 20), ('recreate', 20)] for i in range(count)}
+                if {row[1] for row in samples} != expected | {'initial'}:
+                    raise ValueError('Incomplete performance phases')
+                item = {'round': round_id, 'firstOpenMs': int(opens[round_id].split('\t')[1])}
+                for phase in ['before', 'after']:
+                    selected = [row for row in samples if row[1].startswith(phase + '-')]
+                    elapsed = int(selected[-1][2]) - int(selected[0][2])
+                    cpu = int(selected[-1][3]) - int(selected[0][3])
+                    if elapsed < 60_000_000_000 or cpu < 0:
+                        raise ValueError('Invalid idle sampling duration or CPU counter')
+                    item[phase] = {'cpuPercent': cpu / elapsed * 100,
+                                   'rssMiB': median(int(row[4]) for row in selected) / 1024,
+                                   'heapMiB': median(int(row[5]) for row in selected) / (1024 ** 2)}
+                performance.append(item)
+            if len((run/'screenshots.tsv').read_text().splitlines()) != 6:
+                raise ValueError('Missing actual-screen diagnostics')
+            graphics = (run/'graphics.tsv').read_text().splitlines()
+            if len(graphics) != 3 or len({line.split('\t', 1)[1] for line in graphics}) != 1:
+                raise ValueError('Graphical measurement conditions changed')
+            report.update(performance=performance, graphics=graphics[0].split('\t')[1:])
+        report.update(status='passed',tests=1,skipped=0,processes=expected_processes,lifecycle=lifecycle,
+                      actualIde=json.loads((run/'actual-ide.json').read_text()))
+
+except EnvironmentBlocked as e:
+    report.update(status='environment-blocked',code=e.code,message=str(e))
+except Exception as e:
+    report.update(status='failed',message=str(e))
+finally:
+    write_json(run/'report.json',report)
+    print(json.dumps(report,ensure_ascii=False),flush=True)
+    print(f'S0 report: {run}/report.json',flush=True)
+sys.exit(0 if report['status']=='passed' else 2)
